{
  "name": "concrete-compression",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "import:log": "dotenv -e .env.local -- npx tsx src/scripts/import-master-log.ts",
    "fix:air": "dotenv -e .env.local -- npx tsx src/scripts/fix-air-content.ts",
    "diagnose:air": "dotenv -e .env.local -- npx tsx src/scripts/diagnose-air.ts",
    "fix:bad-air": "dotenv -e .env.local -- npx tsx src/scripts/fix-bad-air.ts",
    "diagnose:tickets": "dotenv -e .env.local -- npx tsx src/scripts/diagnose-ticket-matches.ts",
    "dump:headers": "dotenv -e .env.local -- npx tsx src/scripts/dump-log-headers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@clerk/nextjs": "^7.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.3.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
